<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build: dotnet build -c Release -p:KSPDIR=/path/to/Kerbal\ Space\ Program -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>RocketFailure</AssemblyName>
    <RootNamespace>RocketFailure</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <KSPDIR Condition="'$(KSPDIR)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Kerbal Space Program</KSPDIR>
    <KSPManaged Condition="Exists('$(KSPDIR)/KSP_Data/Managed')">$(KSPDIR)/KSP_Data/Managed</KSPManaged>
    <KSPManaged Condition="'$(KSPManaged)' == ''">$(KSPDIR)/KSP_x64_Data/Managed</KSPManaged>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies so net472 builds on Linux/macOS without Mono. Build-time only. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(KSPManaged)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(KSPManaged)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(KSPManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(KSPManaged)/UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="CopyToGameData" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)/GameData/RocketFailure/Plugins" />
  </Target>
</Project>
